# /etc/wanguard-antidpi/config - included (sourced) by the init script and
# the CLI. sh-style assignments only, one word per value; the strategy line
# is word-split (see NOTE below).
#
# The file is protected by apk (/etc): a user-modified copy survives
# upgrades; the new default arrives as config.apk-new next to it.
#
# Engine lifecycle is the add-on's own; the desync STRATEGY itself is filled
# from blockcheck sessions (issue #64, hitl). Until then the engine idles:
# it opens the queue and passes queued packets unmodified (graceful no-op).

# NFQUEUE number nfqws2 binds (design constant; nft-render substitutes it
# into the table template)
QNUM=300

# mark nfqws2 stamps on its own generated/fake packets to prevent loops
# (upstream default; keep unless blockcheck says otherwise)
DESYNC_MARK=0x40000000

# user the engine drops privileges to after queue setup (upstream default)
WS_USER=daemon

# 1 = append --debug=1 (verbose engine log -> syslog -> `logread | grep
# nfqws2`). For blockcheck sessions only - do not leave enabled.
NFQWS2_DEBUG=0

# Desync strategy passed to nfqws2 verbatim, word-split; `--new` starts the
# next profile set (upstream NFQWS2_OPT convention).
# NOTE: arguments containing spaces are not supported (word-split contract);
# one argument per shell word.
# Example (upstream default shape, NOT tuned for this network):
#   NFQWS2_OPT="--filter-tcp=443 --filter-l7=tls --payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5 --new --filter-udp=443 --filter-l7=quic --payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=6"
NFQWS2_OPT=""
