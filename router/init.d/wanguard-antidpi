#!/bin/sh /etc/rc.common
# wanguard-antidpi init (issues #57/#60): nfqws2 engine scoped to mihomo
# DIRECT egress. Own lifecycle (ad-on pattern) - upstream zapret2's installer
# and its init.d/openwrt are NOT used.
#
# start: ensure the mihomo routing-mark (idempotent inject + live REST reload,
#        non-fatal) -> refresh the tunnel exclusion set (resolver updater,
#        non-fatal; the persisted list covers boot-time DNS outages) -> render
#        the SNI whitelist hostlist (non-fatal; the engine refuses to start
#        without the file, so a missing file fails the start loudly) -> apply
#        the own nft table -> ensure the periodic update cron line -> procd
#        instance (respawn)
# stop : procd kills the instance -> drop the cron line -> flush the nft table
#
# The routing-mark persists in the mihomo config across stop/restart BY
# DESIGN (it is harmless without the queue rules): explicit removal is
# `wanguard-antidpi mark-remove` (restores the config and disarms the init
# hook via the no-mark stamp). Docs: README + docs/ARCHITECTURE.md.
#
# DRYRUN contract (container matrix, issues #57/#63):
#   WANGUARD_ANTIDPI_DRYRUN=1 start   -> print actions, touch nothing
#   WANGUARD_ANTIDPI_DRYRUN=1 stop    -> print actions, touch nothing
#
# Logging goes to syslog (logread): procd captures engine stdout/stderr,
# lifecycle events are logged via logger. NFQWS2_DEBUG=1 (config) appends
# --debug=1 for blockcheck sessions - temporary by design.

USE_PROCD=1
START=25
STOP=90

CLI=/usr/bin/wanguard-antidpi

start_service() {
	if [ "${WANGUARD_ANTIDPI_DRYRUN:-0}" = "1" ]; then
		"$CLI" nft-apply
		echo "DRYRUN: would ensure the mihomo routing-mark (mark-ensure)"
		echo "DRYRUN: would refresh the tunnel exclusion set (tunnel-update)"
		"$CLI" tunnel-update
		echo "DRYRUN: would render the SNI whitelist hostlist (whitelist-refresh)"
		"$CLI" whitelist-refresh
		echo "DRYRUN: would ensure the periodic update cron line (cron-install)"
		"$CLI" cron-install
		echo "DRYRUN: would start procd instance:"
		"$CLI" engine-cmdline
		return 0
	fi

	# scope mark integration (#60): idempotent, self-healing - injects the
	# mark when missing (boot: mihomo not up yet, S99 picks the config up;
	# running system: inject + live REST reload). Non-fatal by contract:
	# a failure must not keep the engine/queue down, the mark lands on the
	# next mihomo restart either way.
	"$CLI" mark-ensure || logger -t wanguard-antidpi "mark-ensure failed (non-fatal; see logread)"

	# tunnel exclusion (#62): refresh the resolver-managed set BEFORE the
	# table apply so the first apply already carries the fresh answers.
	# Non-fatal: boot-time DNS outages keep the last known UCI list (it
	# persists across reboots); the periodic cron run heals it later.
	"$CLI" tunnel-update || logger -t wanguard-antidpi "tunnel-update failed (non-fatal; keeping the last known set)"

	# SNI whitelist (issue #70): render the hostlist BEFORE the engine start -
	# nfqws2 refuses to start when the --hostlist file is missing, so a failed
	# refresh must never leave whitelist mode with a truly absent file (the
	# start below then fails loudly instead of silently desyncing everything;
	# a failed refresh that keeps the previous file is the soft direction).
	# Non-fatal for the rest of the start sequence by the same contract as
	# tunnel-update.
	"$CLI" whitelist-refresh || logger -t wanguard-antidpi "whitelist-refresh failed (non-fatal; see logread)"

	"$CLI" nft-apply || return 1

	# periodic updater trigger (#62): one tagged line in /etc/crontabs/root
	# (busybox crond reloads changed crontab files itself); no hosts
	# configured or update_interval=0 -> the CLI keeps it absent
	"$CLI" cron-install || logger -t wanguard-antidpi "cron-install failed (non-fatal; manual tunnel-update still works)"

	# word-split the one-arg-per-line output into argv (IFS includes \n)
	set -- $("$CLI" engine-cmdline)
	prog=$1
	shift
	procd_open_instance wanguard-antidpi
	procd_set_param command "$prog" "$@"
	# respawn on crash (same policy as wanguard core)
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	if [ "${WANGUARD_ANTIDPI_DRYRUN:-0}" = "1" ]; then
		echo "DRYRUN: would drop the periodic update cron line (cron-remove)"
		"$CLI" cron-remove
		echo "DRYRUN: would flush the nft table (procd already stopped the engine)"
		return 0
	fi
	# called by stop() after procd killed the instances; a disabled service
	# must not keep a periodic updater behind
	"$CLI" cron-remove
	"$CLI" nft-flush
}
