# /etc/config/wanguard-antidpi - UCI config, source of truth (issue #67).
# Read by the ucode CLI via the native uci bindings; unknown/missing options
# fall back to the published defaults (docs/ARCHITECTURE.md).
# apk protects /etc: user edits survive upgrades - the new default arrives
# as /etc/config/wanguard-antidpi.apk-new next to it.

config engine 'engine'

	# NFQUEUE number nfqws2 binds (nft-render substitutes it into the table
	# template); strictly numeric
	option qnum '300'

	# mark nfqws2 stamps on its own generated/fake packets to prevent loops
	# (upstream default; keep unless blockcheck says otherwise)
	option fwmark '0x40000000'

	# user the engine drops privileges to after queue setup (upstream default)
	option user 'daemon'

	# 1 = append --debug=1 (verbose engine log -> syslog -> `logread | grep
	# nfqws2`). For blockcheck sessions only - do not leave enabled.
	option debug '0'

	# Desync strategy: ONE ARGV WORD per list item; '--new' starts the next
	# profile set (upstream NFQWS2_OPT convention). Each list item is passed
	# to nfqws2 verbatim (no shell word splitting). Empty = graceful no-op:
	# the engine binds the queue and passes packets unmodified until the
	# strategy is tuned from blockcheck sessions (issue #64, hitl).
	# Example shape (NOT tuned for any specific network):
	#	list nfqws2_opt '--filter-tcp=443'
	#	list nfqws2_opt '--filter-l7=tls'
	#	list nfqws2_opt '--new'
	#	list nfqws2_opt '--filter-udp=443'
	#	list nfqws2_opt '--filter-l7=quic'

config mihomo 'mihomo'

	# mihomo routing-mark integration (issue #60): the CLI injects one
	# root-level line 'routing-mark: 268435456' with a backup, validates with
	# `mihomo -t` and reloads mihomo via its REST API. Paths follow the stock
	# layout; change only if the mihomo setup is non-standard.

	# mihomo config the mark is injected into
	# (backup taken at install: <this>.bak-wanguard-antidpi)
	option conffile '/etc/mihomo/config.yaml'

	# mihomo workdir: the reload recipe (PUT /configs?force=true) accepts only
	# paths under the workdir, so the edited config is copied here before the
	# REST call. external-controller and secret are parsed from the config
	# itself; the secret never leaves the router (passed to curl via a
	# temporary header file, not through argv).
	option workdir '/usr/share/mihomo'

config tunnel 'tunnel'

	# ---- manual static pins ----
	# upstream proxy/tunnel endpoints excluded from the add-on's queue scope
	# (issues #61/#62), rendered into the nft set `proxy_servers` on every
	# apply together with the resolver-managed list below. Never touched by
	# the updater - use for a fixed server address or an escape hatch.
	# Canonical IPv4 or CIDR entries.
	#
	#	list proxy_servers '203.0.113.7'
	#	list proxy_servers '203.0.113.0/24'

	# ---- resolver updater (issue #62) ----
	# Hostnames of the upstream proxy/tunnel endpoints. `wanguard-antidpi
	# tunnel-update` (runs on every service start and periodically via cron)
	# resolves them with nslookup, keeps every observed A record and ages
	# entries out after expire_hours - the tunnel daddr rotates, one answer
	# rarely carries all addresses. Until the set is populated the tunnel is
	# NOT excluded from the queue, so keep the engine strategy empty (graceful
	# no-op): desynchronizing the tunnel's own TLS would break the tunnel.
	# At least two labels required (single labels cannot resolve via DNS).
	#
	#	list tunnel_hosts 'cdn.example.net'

	# hours between periodic updates (cron); 0 = manual updates only
	#	option update_interval '6'

	# hours an IP survives without being seen in DNS answers; 0 = never expire
	#	option expire_hours '24'

	# MACHINE-MANAGED by `tunnel-update`: the current resolver answers plus
	# entries not yet expired. Do not edit - static pins go to proxy_servers
	# above. Rendered into the nft set on every apply together with them.
	#	list proxy_resolved '203.0.113.10'

config whitelist 'whitelist'

	# ---- SNI whitelist (issue #70) ----
	# 1 = desync is applied ONLY to the domains below (SNI-based, suffix
	# match: subdomains auto-apply). 0 or a missing section = blanket mode
	# (desync for every queued target - the classic behavior).
	#
	# While enabled, the rendered hostlist file
	# (/usr/share/wanguard-antidpi/whitelist.hosts, machine-managed by
	# `wanguard-antidpi whitelist-refresh`) is a HARD engine dependency:
	# nfqws2 refuses to start without it, and an empty domain list is
	# rejected at render time - keep at least one valid domain here.
	# Strict DNS names only: no wildcards (suffix matching already covers
	# subdomains), no commas/spaces (rejected loudly at render time).
	#
	# Apply changes without dropping connections:
	#   wanguard-antidpi whitelist-reload
	# (renders the file and signals the running engine to re-read its lists;
	# a service restart works too).
	#
	#	option enabled '0'
	#	list domains 'example.org'
	#	list domains 'example.net'

# ---- named domain lists (issue #82) ----
# Additional sources for the same hostlist file: every `config domainlist`
# section below merges with whitelist.domains (deduped, sorted) when
# whitelist mode is on. The section NAME is the stable id (policies
# reference it), `name` is the editable label shown in the LuCI page.
# Same strict DNS rules: no wildcards (suffix matching already covers
# subdomains), no commas/spaces (rejected loudly at render time).
#
# Lists are edited from Network -> Wanguard -> Anti-DPI -> Domain lists;
# they are inert while whitelist mode is off (blanket mode desyncs
# everything regardless of any list).
#
#config domainlist 'list_media'
#	option name 'Video domains'
#	list domains 'example.org'
#	list domains 'example.net'

# ---- policies (issue #86) ----
# Ordered match -> action rules rendered as FIRST nfqws2 profile blocks,
# before the global strategy catch-all (first match wins). Each policy
# scopes its block to a domainlist and a protocol:
#   action 'strategy' - desync the matched traffic with the referenced
#     profile's strategy words (refs go by the profile SECTION name);
#   action 'bypass'   - pass the matched traffic UNMODIFIED (a profile
#     with filters and a hostlist but no desync functions);
#   action 'none'     - render no block (the traffic falls through to the
#     global strategy; the policy stays validated loudly).
# Order = `option priority` ascending (step 10 is the convention, the UI
# renumbers). The per-list hostlist files are machine-managed by
# `whitelist-refresh` (/usr/share/wanguard-antidpi/lists/<list>.hosts);
# while any policy renders a block, the whitelist binding is ignored -
# policies own their hostlists. Tunnel/proxy exclusions (the nft set and
# --ipset-exclude-ip) stay ABOVE every policy: only mihomo DIRECT traffic
# is ever eligible. `device_group` is stored for future group targeting
# and ignored by the current render (no client identity in the queue).
#
#config policy 'pol_video'
#	option name 'Video traffic'
#	option priority '10'
#	option domainlist 'list_media'
#	option proto 'tcp quic'
#	option device_group ''
#	option action 'bypass'
#	option profile ''
#	option enabled '1'
